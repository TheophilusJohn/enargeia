# R2, on a custom domain rather than the r2.dev subdomain: r2.dev is rate limited and
# documented as development-only, and a zone domain gets Cloudflare's cache in front of it.
# The bucket's CORS policy lists the origins allowed to range-request this.
VITE_MODEL_URL=https://models.enargeia.dev/qwen2.5-0.5b.enargeia
